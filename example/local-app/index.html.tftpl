<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Local deployment · ${release}</title>
  <style>
    body { margin: 0; background: #f4f6f8; color: #182333; font: 18px/1.6 system-ui, sans-serif; }
    main { max-width: 42rem; margin: 12vh auto; padding: 2rem; background: white; border-radius: 1rem; }
    h1 { line-height: 1.2; }
    .release { display: inline-block; border-radius: 1rem; padding: .2rem .8rem; background: #d9f6e5; color: #145b33; }
    a { color: #184fc4; }
  </style>
</head>
<body>
  <main>
    <p>Terraform local application</p>
    <h1>Your deployment is running.</h1>
    <p>Current release: <strong class="release">${release}</strong></p>
    <p>This page is generated by Terraform and served from the local filesystem.</p>
    <p><a href="/health">Check server health</a></p>
  </main>
</body>
</html>
